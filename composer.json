{
    "name": "ochoamusicsv/recaudacion",
    "description": "Sistema de recaudación municipal (contribuyentes, propiedad, tributos, facturación diaria, cierres e historial, reportería de mora).",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php -l src/ || true"
    },
    "config": {
        "sort-packages": true
    }
}
